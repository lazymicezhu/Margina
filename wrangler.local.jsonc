{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margina-local-only",
  "send_metrics": false,
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-22",
  "assets": { "directory": "./dist-cloud", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "ENVIRONMENT": "local", "LOCAL_DEV_AUTH": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "margina-local", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "margina-local-files" }],
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
