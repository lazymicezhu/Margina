{
  "name": "margina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "build:cloud": "node scripts/cloud-build.mjs",
    "dev:cloud": "node scripts/cloud-local.mjs",
    "deploy:cloud": "npm run build:cloud && node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.production.jsonc",
    "db:cloud": "node node_modules/wrangler/bin/wrangler.js d1 execute margina --remote --file server/schema.sql --config wrangler.production.jsonc",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.2-beta",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.152.0"
  },
  "description": "A mobile-first bilingual paper reader with local notes and highlights.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lazymicezhu/Margina.git"
  }
}
