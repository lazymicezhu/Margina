{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margina",
  "account_id": "f1d5f8949c8e69f94058620eaf296578",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-22",
  "assets": { "directory": "./dist-cloud", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    "ENVIRONMENT": "production",
    "LOCAL_DEV_AUTH": "false",
    "PASSWORD_AUTH": "true",
    "MAX_STORAGE_BYTES": "8000000000",
    "ACCESS_ISSUER": "https://2644860482.cloudflareaccess.com",
    "ACCESS_AUD": "b229b6513427416a414c5d9aac07bff9ada9386947d6c1f15644962dadc637b1"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "margina", "database_id": "814e366e-3e42-4c9c-8da3-8dfdb765e67a" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "margina-files" }]
}
